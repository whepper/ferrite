libfdk-xhe-aac.la: $(libfdk_xhe_aac_la_OBJECTS) $(libfdk_xhe_aac_la_DEPENDENCIES) $(EXTRA_libfdk_xhe_aac_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libfdk_xhe_aac_la_LINK) -rpath $(libdir) $(libfdk_xhe_aac_la_OBJECTS) $(libfdk_xhe_aac_la_LIBADD) $(LIBS)

aac-dec$(EXEEXT): $(aac_dec_OBJECTS) $(aac_dec_DEPENDENCIES) $(EXTRA_aac_dec_DEPENDENCIES) 
	@rm -f aac-dec$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(aac_dec_OBJECTS) $(aac_dec_LDADD) $(LIBS)

aac-enc$(EXEEXT): $(aac_enc_OBJECTS) $(aac_enc_DEPENDENCIES) $(EXTRA_aac_enc_DEPENDENCIES) 
	@rm -f aac-enc$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(aac_enc_OBJECTS) $(aac_enc_LDADD) $(LIBS)

test-encode-decode$(EXEEXT): $(test_encode_decode_OBJECTS) $(test_encode_decode_DEPENDENCIES) $(EXTRA_test_encode_decode_DEPENDENCIES) 
	@rm -f test-encode-decode$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(test_encode_decode_OBJECTS) $(test_encode_decode_LDADD) $(LIBS)

xhe-aac-enc$(EXEEXT): $(xhe_aac_enc_OBJECTS) $(xhe_aac_enc_DEPENDENCIES) $(EXTRA_xhe_aac_enc_DEPENDENCIES) 
	@rm -f xhe-aac-enc$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(xhe_aac_enc_OBJECTS) $(xhe_aac_enc_LDADD) $(LIBS)

