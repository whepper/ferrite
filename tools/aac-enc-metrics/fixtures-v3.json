  "alignment": {
    "nominal_lag_samples": 1600,
    "search_half_width_samples": 32,
    "channel_tolerance_samples": 1,
    "nominal_tolerance_samples": 1,
    "tie_epsilon": 1e-09,
    "coarse_step_samples": 8,
    "short_signal_threshold_samples": 48000,
    "short_signal_coarse_step_samples": 1,
    "refine_half_width_samples": 2,
    "long_signal_refine_half_width_samples": 4,
    "sign_convention": "positive lag means decoded[lag:] aligns with original[0:]",
    "method": "Per channel, search integer lags in [nominal-half, nominal+half] by normalized cross-correlation. Use stride 1 for short signals and stride 8 for long signals. Refine the best coarse candidate at full rate over +/-2 samples for short signals and +/-4 samples for long signals; the long span covers the whole stride-8 cell. For stereo, require the two channel estimates to agree within +/-1 sample; select the nominal lag when both estimates are within +/-1 of nominal, otherwise select the joint best candidate. A best candidate at the search boundary, a score tie, no signal, a channel disagreement, or a selected lag outside nominal +/-1 is ambiguous and excludes the stream from quality metrics.",
    "ambiguity_rules": [
      "no_signal: no defined normalized correlation for any searched lag",
      "search_boundary: best candidate equals the lower or upper search bound",
      "score_tie: second-best separated candidate is within 1e-9 normalized correlation",
      "channel_lag_disagreement: stereo channel estimates differ by more than 1 sample",
      "outside_nominal_tolerance: selected lag differs from nominal by more than 1 sample"
    ],
    "delay_accounting": "The decoder CLI drops outputDelay once. The metric applies only the selected alignment lag to the decoded WAV; outputDelay is recorded but never subtracted again.",
    "frame_mapping": "Not used in F04-B1. No causal AAC-frame-to-source-sample mapping is asserted."
  },
