rust_library {
    name: "libferrite_aac",
    crate_name: "ferrite_aac",

    vendor_available: true,
    clippy_lints: "android",
    host_supported: true,
    srcs: ["src/lib.rs"],

    features: [
        "aac_enc",
    ],

    rustlibs: [
        "libitertools",
        "libnum_complex",
        "libarrayvec",
        "libbitflags",
        "libzerocopy",
    ],

    proc_macros: [
        "libpaste",
    ],

    apex_available: [
        "//apex_available:platform",
        "com.android.bt",
        "com.android.media.swcodec",
    ],
    min_sdk_version: "29",
}
