+
+impl DistCache {
+    /// Binds the cache to one pass and drops every previous entry.
+    fn reset(&mut self, bands: usize) {
+        self.entries.clear();
+        self.entries
+            .resize(bands * DIST_CACHE_SLOTS, DistCacheEntry::default());
+        self.pool.clear();
+        self.tick = 0;
+    }
