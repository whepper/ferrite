+        assert_eq!(second[written..], vec![7i16; width - written], "tail untouched");
+    }
+
+    #[test]
+    fn dist_cache_evicts_least_recently_used() {
+        let spec = vec![1000i32; 2];
+        let mut cache = DistCache::default();
+        cache.reset(1);
+        let mut q = vec![0i16; 2];
+        for g in 0..8 {
+            let _ = cache.dist(0, &spec, g, false, &mut q);
+        }
+        // Touch gain 0 so gain 1 becomes the LRU entry.
+        let _ = cache.dist(0, &spec, 0, false, &mut q);
+        let _ = cache.dist(0, &spec, 8, false, &mut q);
+        assert!(cache.is_cached(0, 0), "touched entry survives");
+        assert!(!cache.is_cached(0, 1), "LRU entry evicted");
+        assert!(cache.is_cached(0, 8), "new entry stored");
+    }
+
+    #[test]
+    fn dist_cache_reset_and_empty_band() {
+        let mut cache = DistCache::default();
+        cache.reset(3);
+        let mut q = vec![0i16; 2];
+        let _ = cache.dist(2, &[1, 2], 5, false, &mut q);
+        assert!(cache.is_cached(2, 5));
+        cache.reset(1);
+        assert!(!cache.is_cached(0, 5));
+        // Empty band: no write, distance still defined.
+        let d = cache.dist(0, &[], 5, false, &mut []);
+        let mut probe = Vec::new();
+        let d2 = crate::aac_enc::quant::calc_sfb_dist(&[], 5, false, &mut probe);
+        assert_eq!(d, d2);
+        assert!(cache.is_cached(0, 5));
+    }
+
+    #[test]
+    fn dist_cache_randomized_differential() {
+        // Production invariant: one fixed spectrum per band per pass; only
+        // the gain varies. Random gains (including negative ones that take
+        // the early-out), random destination tails.
+        let mut state = 0xC0FF_EE12_3456_789Au64;
+        let bands = 4usize;
+        let mut cache = DistCache::default();
+        cache.reset(bands);
+        let specs: Vec<Vec<i32>> = (0..bands)
+            .map(|_| {
+                let width = 1 + (lcg(&mut state) % 16) as usize;
+                (0..width)
+                    .map(|_| {
+                        let v = lcg(&mut state) as i32;
+                        match lcg(&mut state) % 4 {
+                            0 => 0,
+                            1 => v >> 12,
+                            2 => v,
+                            _ => v >> 28,
+                        }
+                    })
+                    .collect()
+            })
+            .collect();
+        for _ in 0..50_000 {
+            let band = (lcg(&mut state) % bands as u32) as usize;
+            let spec = &specs[band];
+            let width = spec.len();
+            let gain = (lcg(&mut state) % 240) as i32 - 120;
+            let tail = (lcg(&mut state) % 3) as i16;
+            let mut got = vec![tail; width];
+            let mut want = vec![tail; width];
+            let d1 = cache.dist(band, spec, gain, false, &mut got);
+            let d2 = crate::aac_enc::quant::calc_sfb_dist(spec, gain, false, &mut want);
+            assert_eq!(d1, d2, "dist band={band} gain={gain}");
+            assert_eq!(got, want, "quant band={band} gain={gain}");
+        }
+    }
+
+    #[test]
+    fn dist_cache_full_pass_matches_uncached() {
+        // Same full S4 pass with the cache enabled and bypassed, compared
+        // over every committed S4 corpus case and checkpoint.
+        use super::super::testdata;
+        for (name, f) in S4_CASES {
+            let s1 = testdata::load_s1(name, f);
+            let s2 = testdata::load_s2(name, f);
+            let s4 = testdata::load_s4(name, f);
+            for (ci, ((c1, c2), c4)) in s1.ch.iter().zip(s2.ch.iter()).zip(s4.ch.iter()).enumerate()
+            {
+                if c4.levels.is_empty() {
+                    continue;
+                }
+                let spec0 =
+                    s4_input_spec(&c1.spec, &c1.offsets, c1.geo_cnt, c1.geo_per, c1.geo_max);
+                for lv in &c4.levels {
+                    let mut run = |no_cache: bool| {
+                        let mut spec = spec0.clone();
+                        let mut ws = ScfWorkspace::default();
+                        if no_cache {
+                            ws.dist_cache.disable();
+                        }
+                        let mut input = ScfChannelInput {
+                            spectrum: &mut spec,
+                            energy_ld: &c1.penld,
+                            threshold_ld: &c2.thrv,
+                            form_factor_ld: &c1.ff,
+                            geo: ScfGeometry {
+                                offsets: &c1.offsets,
+                                sfb_cnt: c1.geo_cnt,
+                                sfb_per_group: c1.geo_per,
+                                max_sfb_per_group: c1.geo_max,
+                            },
+                        };
+                        estimate_channel_with_inv_ws(&mut input, lv.inv, &mut ws)
+                    };
+                    let on = run(false);
+                    let off = run(true);
+                    assert_eq!(on.scf, off.scf, "{name} f={f} ch={ci} inv={} scf", lv.inv);
+                    assert_eq!(
+                        on.global_gain, off.global_gain,
+                        "{name} f={f} ch={ci} inv={} gain",
+                        lv.inv
+                    );
+                    assert_eq!(
+                        on.quant_spec, off.quant_spec,
+                        "{name} f={f} ch={ci} inv={} q",
+                        lv.inv
+                    );
+                    assert_eq!(
+                        on.mutated_spectrum, off.mutated_spectrum,
+                        "{name} f={f} ch={ci} inv={} spec",
+                        lv.inv
+                    );
+                }
+            }
+        }
+    }
