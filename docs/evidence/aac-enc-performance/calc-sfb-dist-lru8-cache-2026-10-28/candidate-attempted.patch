 /// reset, so no information crosses calls and per-channel isolation is
 /// preserved. Plain owned buffers: no unsafe, no globals, no caches.
+/// Per-band LRU cache for `calc_sfb_dist` inside a single S4 pass.
+///
+/// A pass evaluates the same `(band, gain)` more than once (§25: 13–18% of
+/// lines). The distance and the prefix written to `quant` are a pure
+/// function of the band spectrum, `gain` and `dz`, and the spectrum is
+/// immutable for the whole pass, so a hit replays the exact prefix write
+/// (leaving the tail untouched, as the early-out path does) and returns the
+/// cached distance.
+const DIST_CACHE_SLOTS: usize = 8;
+
+#[derive(Clone, Copy, Default)]
+struct DistCacheEntry {
+    gain: i32,
+    dist: i32,
+    pool_off: u32,
+    len: u16,
+    stamp: u32,
+    dz: bool,
+    used: bool,
