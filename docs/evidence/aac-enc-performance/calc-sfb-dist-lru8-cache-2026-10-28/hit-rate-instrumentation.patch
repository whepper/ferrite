+    // TEMP HIT-RATE TEST (removed before final state).
+    #[test]
+    fn zz_cache_hit_rate() {
+        use super::super::config::{EncoderConfig, TransportType, FRAME_LENGTH};
+        use super::super::pcm::PcmFeeder;
+        use super::super::stream_driver::StreamEncoder;
+        use super::super::testdata;
+        use std::sync::atomic::Ordering;
+
+        fn load(c: &std::sync::atomic::AtomicU64) -> u64 {
+            c.load(Ordering::Relaxed)
+        }
+
+        for (short, ch) in [
+            ("music-stereo", 2usize),
+            ("speech-clean-stereo", 2),
+            ("onset-stereo", 2),
+            ("sine-stereo", 2),
+            ("noise-mono", 1),
+        ] {
+            let (l0, h0, m0, w0) = (
+                load(&cache_stats::LOOKUPS),
+                load(&cache_stats::HITS),
+                load(&cache_stats::MISSES),
+                load(&cache_stats::WRITTEN),
+            );
+            let pcm = testdata::fixture_samples(short);
+            let cfg = EncoderConfig::new(48000, ch as u32, FRAME_LENGTH, TransportType::Adts)
+                .expect("cfg");
+            let s = pcm[0].len();
+            let mut inter = Vec::with_capacity(s * ch);
+            for i in 0..s {
+                for c in pcm.iter().take(ch) {
+                    inter.push(c[i]);
                 }
             }
+            let mut feeder = PcmFeeder::new(cfg);
+            let mut frames = feeder.push_interleaved(&inter).expect("push");
+            frames.extend(feeder.finish().expect("finish"));
+            let mut enc = StreamEncoder::new(48000, ch);
+            for (i, fr) in frames.iter().enumerate() {
+                let fresh: Vec<Vec<i16>> = fr.channels().iter().map(|b| b.to_vec()).collect();
+                assert!(enc.step_frame(i as u32, &fresh).0.is_some());
+            }
+            let look = load(&cache_stats::LOOKUPS) - l0;
+            let hits = load(&cache_stats::HITS) - h0;
+            let misses = load(&cache_stats::MISSES) - m0;
+            let written = load(&cache_stats::WRITTEN) - w0;
+            eprintln!(
+                "CACHE {short}: lookups={look} hits={hits} ({:.1}%) misses={misses} written_lines={written}",
+                100.0 * hits as f64 / look.max(1) as f64
+            );
         }
