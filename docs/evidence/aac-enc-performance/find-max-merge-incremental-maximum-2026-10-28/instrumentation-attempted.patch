+    #[test]
+    fn zz_stage2_topology_stats() {
+        use super::super::config::{EncoderConfig, TransportType, FRAME_LENGTH};
+        use super::super::pcm::PcmFeeder;
+        use super::super::stream_driver::StreamEncoder;
+        use super::super::testdata;
+        use std::sync::atomic::Ordering;
+
+        fn run(short: &str, sr: u32, ch: usize) {
+            let pcm = testdata::fixture_samples(short);
+            let cfg = EncoderConfig::new(sr, ch as u32, FRAME_LENGTH, TransportType::Adts)
+                .expect("cfg");
+            let s = pcm[0].len();
+            let mut inter = Vec::with_capacity(s * ch);
+            for i in 0..s {
+                for c in pcm.iter().take(ch) {
+                    inter.push(c[i]);
+                }
+            }
