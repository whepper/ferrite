+// TEMP CALL-PATH AUDIT (removed before final state).
+pub(crate) mod qdup {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub static FRAMES: AtomicU64 = AtomicU64::new(0);
+    pub static CALLS: AtomicU64 = AtomicU64::new(0);
+    pub static DISTINCT: AtomicU64 = AtomicU64::new(0);
+    pub static DUPS: AtomicU64 = AtomicU64::new(0);
+    pub static DUP_LINES: AtomicU64 = AtomicU64::new(0);
+    pub static PASSES: AtomicU64 = AtomicU64::new(0);
+    pub static SAME_SPECTRUM_AS_PREV: AtomicU64 = AtomicU64::new(0);
+    pub static BAND_HITS: [AtomicU64; 4] = [
+        const { AtomicU64::new(0) },
+        const { AtomicU64::new(0) },
+        const { AtomicU64::new(0) },
+        const { AtomicU64::new(0) },
+    ];
+    pub static MAX_BAND_DISTINCT: AtomicU64 = AtomicU64::new(0);
+    pub static LINES: AtomicU64 = AtomicU64::new(0);
+    pub static ZERO_Q: AtomicU64 = AtomicU64::new(0);
+    pub static PHASE: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+    pub static DUP_MATRIX: [[AtomicU64; 6]; 6] = [
+        [const { AtomicU64::new(0) }; 6],
+        [const { AtomicU64::new(0) }; 6],
+        [const { AtomicU64::new(0) }; 6],
+        [const { AtomicU64::new(0) }; 6],
+        [const { AtomicU64::new(0) }; 6],
+        [const { AtomicU64::new(0) }; 6],
+    ];
+
+    thread_local! {
+        static FRAME: RefCell<HashMap<(usize, usize, i32, bool), (u16, u8)>> =
+            RefCell::new(HashMap::new());
+        static CURRENT: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    }
+
+    pub fn start_frame() {
+        FRAMES.fetch_add(1, Ordering::Relaxed);
+        FRAME.with(|f| f.borrow_mut().clear());
+        SEEN.with(|s| s.borrow_mut().clear());
+    }
+
+    pub fn set_base(p: usize) {
+        BASE.with(|b| b.set(p));
+    }
+
+    pub fn spectrum_hash(spec: &[i32]) {
+        let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+        for &v in spec {
+            h ^= v as u32 as u64;
+            h = h.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+        PASSES.fetch_add(1, Ordering::Relaxed);
+        LAST_HASH.with(|c| {
+            if c.get() == h {
+                SAME_SPECTRUM_AS_PREV.fetch_add(1, Ordering::Relaxed);
+            }
+            c.set(h);
+        });
+    }
+
+    thread_local! {
+        static LAST_HASH: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+        static BASE: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+        static SEEN: RefCell<HashMap<u32, Vec<i16>>> = RefCell::new(HashMap::new());
+    }
+
+    pub fn phase(i: usize) {
+        PHASE[i].fetch_add(1, Ordering::Relaxed);
+        CURRENT.with(|c| c.set(i));
+    }
+
+    pub fn line() {
+        LINES.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn zero_q() {
+        ZERO_Q.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn record(ptr: usize, len: usize, gain: i32, dz: bool) {
+        CALLS.fetch_add(1, Ordering::Relaxed);
+        let base = BASE.with(|b| b.get());
+        if ptr >= base {
+            let band = ((ptr - base) / 4) as u32;
+            SEEN.with(|s| {
+                let mut m = s.borrow_mut();
+                let v = m.entry(band).or_default();
+                let pos = v.iter().rposition(|&g| g as i32 == gain);
+                if let Some(p) = pos {
+                    let from_end = v.len() - p;
+                    for (i, k) in [2usize, 4, 8].iter().enumerate() {
+                        if from_end <= *k {
+                            BAND_HITS[i].fetch_add(1, Ordering::Relaxed);
+                        }
+                    }
+                    BAND_HITS[3].fetch_add(1, Ordering::Relaxed);
+                    v.remove(p);
+                }
+                v.push(gain as i16);
+                if (v.len() as u64) > MAX_BAND_DISTINCT.load(Ordering::Relaxed) {
+                    MAX_BAND_DISTINCT.store(v.len() as u64, Ordering::Relaxed);
+                }
+                if v.len() > 64 {
+                    v.remove(0);
+                }
+            });
+        }
+        let cur = CURRENT.with(|c| c.get());
+        FRAME.with(|f| {
+            let mut m = f.borrow_mut();
+            let e = m.entry((ptr, len, gain, dz)).or_insert((0, cur as u8));
+            if e.0 == 0 {
+                DISTINCT.fetch_add(1, Ordering::Relaxed);
+                e.1 = cur as u8;
+            } else {
+                DUPS.fetch_add(1, Ordering::Relaxed);
+                DUP_LINES.fetch_add(len as u64, Ordering::Relaxed);
+                DUP_MATRIX[e.1 as usize][cur].fetch_add(1, Ordering::Relaxed);
+            }
+            e.0 += 1;
+        });
+    }
+}
 
