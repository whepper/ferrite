+    /// Original `gmStage2`, unchanged, for differential testing.
+    fn gm_stage2_ref(
+        sections: &mut [SectionInfo],
+        merge_gain: &mut [i32],
+        bit_lookup: &mut [[i32; 12]],
+        max_sfb: usize,
+        side_info_tab: &[i16],
+        use_vcb11: bool,
+    ) {
+        let mut i = 0;
+        while i + (sections[i].sfb_cnt as usize) < max_sfb {
+            let nxt = i + sections[i].sfb_cnt as usize;
+            merge_gain[i] =
