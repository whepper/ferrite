+    /// Builds a stage-1-shaped section list: runs of equal code book with
+    /// the `sfb_start` breadcrumb on each run's last element, plus
+    /// per-band lookup rows. `books` selects the code-book pool.
+    fn synthetic_stage1(
+        state: &mut u64,
+        max_sfb: usize,
+        books: &[i32],
+    ) -> (Vec<SectionInfo>, Vec<[i32; 12]>) {
+        let mut sections = vec![
+            SectionInfo {
+                code_book: 0,
+                sfb_start: 0,
+                sfb_cnt: 1,
+                section_bits: 0,
+            };
+            max_sfb
+        ];
+        let mut bit_lookup = vec![[0i32; 12]; max_sfb];
+        for (i, row) in bit_lookup.iter_mut().enumerate() {
+            for v in row.iter_mut() {
+                *v = lcg_below(state, 200) as i32 + i as i32;
+            }
+        }
+        let mut s = 0usize;
+        while s < max_sfb {
+            let len = (1 + lcg_below(state, 5) as usize).min(max_sfb - s);
+            let e = s + len - 1;
+            let book = books[lcg_below(state, books.len() as u32) as usize];
+            for (i, sec) in sections.iter_mut().enumerate().take(e + 1).skip(s) {
+                sec.code_book = book;
+                sec.sfb_start = i as i32;
+                sec.sfb_cnt = 1;
+                sec.section_bits = lcg_below(state, 300) as i32;
+            }
+            sections[s].sfb_cnt = len as i32;
+            sections[e].sfb_start = s as i32;
+            s = e + 1;
+        }
+        (sections, bit_lookup)
+    }
